# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vehicle_stock?schema=public"

# Server
PORT=3000
NODE_ENV=development

# Auth — comma-separated API keys (format: "role:key")
# Phase 4: Both JWT AND API-key are mandatory per request
#   Authorization: Bearer <jwt-token>
#   X-API-Key: <api-key>
API_KEYS="admin:your-admin-key,ops:your-ops-key,branch:your-branch-key"

# JWT Auth — Phase 4 (required)
# The secret used to sign and verify HS256 JWTs
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET="your-64-char-random-secret-change-in-production"

# Logging
LOG_LEVEL=info

# Cache TTL in seconds (dashboard summary)
CACHE_TTL=300

# App version
APP_VERSION=1.0.0
