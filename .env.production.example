# ═══════════════════════════════════════════════════
# Production Environment Template
#
# DO NOT commit real values here.
# This file is managed as a Jenkins Secret File at:
#   Jenkins → Manage → Credentials → Secret file → /etc/vehicle-stock/.env.production
#
# docker-compose.prod.yml reads these variables.
# Set them in Jenkins "Environment" section or via EnvInject plugin.
# ═══════════════════════════════════════════════════

# Database
DB_USER=postgres
DB_PASSWORD=<production-db-password>
DB_NAME=vehicle_stock

# App
APP_PORT=6300
NODE_ENV=production
APP_VERSION=1.0.0

# Auth — use strong random values, different from CI/test
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_KEYS=admin:<admin-key>,ops:<ops-key>,branch:<branch-key>
JWT_SECRET=<64-char-random-secret>

# Logging
LOG_LEVEL=info

# Cache
CACHE_TTL=300

# Docker image source
GITHUB_REPO=owner/vehicle-stock
